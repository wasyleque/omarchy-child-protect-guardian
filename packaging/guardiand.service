[Unit]
Description=Omarchy Child Protect Guardian daemon
Documentation=https://github.com/wasyleque/omarchy-child-protect-guardian
# Start after the network is actually up: at boot the daemon's ntfy stream + off-box audit-mirror
# publish would otherwise fail for the first few seconds ("Temporary failure in name resolution") and
# the startup heartbeat could be lost (review R1). network-online.target is best-effort, so the mirror
# loop also retries (daemon ntfy.rs); local-fs.target keeps the key/state dirs available.
Wants=network-online.target
After=network-online.target local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/guardiand /etc/guardian/policy.toml
Restart=always
RestartSec=2
User=root
# /run/guardian must be traversable by the child so it can reach submit.sock (0666). The control
# socket stays 0660 + SO_PEERCRED, so decisions remain root-only regardless of directory mode.
RuntimeDirectory=guardian
RuntimeDirectoryMode=0755
# /var/log/guardian, writable under ProtectSystem=strict, so the audit log can actually be written.
LogsDirectory=guardian
LogsDirectoryMode=0750
# /var/lib/guardian, writable, for the daemon key, screen-time state and grant nonces (review H1):
# without this the first-run key write fails and the unit crash-loops.
StateDirectory=guardian
StateDirectoryMode=0700

ProtectHome=read-only
ProtectSystem=strict
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
