#!/usr/sbin/nft -f
#
# Omarchy Child Protect Guardian — network egress policy for the child account.
# (Threat model §4 L3.) This CONSTRAINS ONLY the child's uid; root, the parent and system
# services are untouched, so guardiand/push, system updates and the parent's session work normally.
#
# Goal: you cannot escape the filtering resolver. We force all DNS to the approved resolver and
# block the usual escapes — DoT, known DoH endpoints, QUIC/UDP VPN smuggling, and arbitrary-port
# tunnels (Tor/Shadowsocks/WireGuard) — while still allowing ordinary web browsing (80/443 TCP).
#
# !!! TEST BEFORE YOU RELY ON IT !!!  Load non-persistently first:  sudo nft -f guardian-egress.nft
# Roll back instantly:  sudo nft delete table inet guardian
# Make persistent only after testing (e.g. include from /etc/nftables.conf or a systemd unit).
#
# Residual risk (documented, not yet closed): a tunnel that speaks TCP/443 and looks like HTTPS
# (Tor bridges, Shadowsocks-over-443) still passes — closing that needs SNI/DPI allowlisting, a
# later step. Everything cheaper and more common than that is blocked here.

# ---- EDIT THESE ----
define CHILD_UID   = 1001                 # the child account's uid (id -u <child>)
define DNS_SERVERS = { 192.168.0.1 }      # your filtering resolver(s): router, Pi-hole, NextDNS, 1.1.1.3 ...
# --------------------

table inet guardian {
    # Known DNS-over-HTTPS resolver IPs (block on 443 so the browser can't bypass DNS filtering).
    set doh_v4 {
        type ipv4_addr
        flags interval
        elements = {
            1.1.1.1, 1.0.0.1,              # Cloudflare
            8.8.8.8, 8.8.4.4,              # Google
            9.9.9.9, 149.112.112.112,      # Quad9
            94.140.14.14, 94.140.15.15     # AdGuard
        }
    }
    set doh_v6 {
        type ipv6_addr
        flags interval
        elements = {
            2606:4700:4700::1111, 2606:4700:4700::1001,
            2001:4860:4860::8888, 2001:4860:4860::8844,
            2620:fe::fe, 2620:fe::9
        }
    }

    chain egress {
        type filter hook output priority filter; policy accept;

        # Anything not from the child is unaffected by this policy.
        meta skuid != $CHILD_UID accept

        # --- from here down: packets originate from the CHILD ---
        oifname "lo" accept
        ct state established,related accept

        # Force name resolution through the approved resolver; block every other DNS path.
        ip daddr $DNS_SERVERS udp dport 53 accept
        ip daddr $DNS_SERVERS tcp dport 53 accept
        udp dport 53 drop
        tcp dport 53 drop
        tcp dport 853 drop                      # DoT
        ip  daddr @doh_v4 tcp dport 443 drop     # known DoH endpoints (v4)
        ip6 daddr @doh_v6 tcp dport 443 drop     # known DoH endpoints (v6)

        # Kill UDP escapes (QUIC on 443, WireGuard, most UDP VPNs). Keep NTP; DNS already allowed above.
        udp dport 123 accept                     # NTP
        meta l4proto udp drop

        # Ordinary web + diagnostics.
        tcp dport { 80, 443 } accept
        ip  protocol icmp accept
        ip6 nexthdr icmpv6 accept

        # Default-deny for the child: blocks arbitrary-port tunnels (Tor/Shadowsocks/custom VPN).
        log prefix "guardian-egress-drop " level info
        drop
    }
}
